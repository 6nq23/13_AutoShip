PORT=8787
CLIENT_ORIGIN=http://localhost:5173,https://auto-ship-client.vercel.app
DATABASE_URL="postgres://postgres:postgres@localhost:5432/auto_aync_prisma?schema=public"
DATABASE_SSL=false
JWT_SECRET=replace-with-a-long-random-secret
INITIAL_ADMIN_PASSWORD=replace-before-production
NIMBUS_API_KEY=npk_your_key
NIMBUS_API_SECRET=your_secret
NIMBUS_API_URL=https://api-v2.nimbuspost.com
NIMBUS_LOOKUP_MAX_PAGES=20
MOCK_MODE=true

# Shopify Dev Dashboard app (client-credential tokens are cached automatically)
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_API_VERSION=2026-07

# WhatsApp: "meta", "whapi", "getgabs", or "disabled"
WHATSAPP_PROVIDER=disabled
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_API_URL=
WHATSAPP_SERVICE_API_URL=
WHATSAPP_SENDER=
WHATSAPP_CAMPAIGN_ID=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=en_US
# Whapi.Cloud: add `x-autoship-webhook-token` with WHATSAPP_VERIFY_TOKEN as a custom callback header.
# If no verify token is set, AutoShip checks this header against WHATSAPP_ACCESS_TOKEN/WHATSAPP_API_KEY.
# Getgabs: set the webhook to `/api/whatsapp/webhook?token=WHATSAPP_VERIFY_TOKEN`.
# Dynamic support replies use the service-message API. Approved outbound templates also need WHATSAPP_TEMPLATE_NAME.

# Human escalation destination, digits with country code preferred
SUPPORT_PHONE_NUMBER=

# AI support agent (configure at least one provider; no provider keeps the deterministic bot)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
CLAUDE_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-20250514
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
AI_PRIMARY_PROVIDER=gemini
AI_MAX_TURNS=3
ESCALATION_PHONE=919924863749
# Optional: defaults to server/data/brain.md (or data/brain.md in auto_ship-backend)
BRAIN_FILE_PATH=
